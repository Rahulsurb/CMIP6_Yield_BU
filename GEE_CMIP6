// ============================================================
// 10. FUNCTION: DISTRICT EXTRACTION
// ============================================================

/*
  Each monthly image is reduced over the 14 districts.

  Spatial aggregation:
      district mean

  Scale:
      27,830 m
      (NASA/GDDP-CMIP6 native resolution)

  Output:
      one Feature per district per month.
*/


function extractDistrictClimate(image) {

  image = ee.Image(image);


  var model = ee.String(
    image.get('MODEL')
  );

  var scenario = ee.String(
    image.get('SCENARIO')
  );

  var year = ee.Number(
    image.get('YEAR')
  );

  var month = ee.Number(
    image.get('MONTH')
  );


  // ----------------------------------------------------------
  // District-level mean
  // ----------------------------------------------------------

  var reduced = image.reduceRegions({
    collection: districts,
    reducer: ee.Reducer.mean(),
    scale: 27830,
    crs: 'EPSG:4326',
    tileScale: 4
  });


  // ----------------------------------------------------------
  // Add metadata to every district record
  // ----------------------------------------------------------

  reduced = reduced.map(
    function(feature) {

      return feature
        .set(
          'DISTRICT',
          feature.get(DISTRICT_FIELD)
        )
        .set('YEAR', year)
        .set('MONTH', month)
        .set('MODEL', model)
        .set('SCENARIO', scenario);
    }
  );


  return reduced;
}



