// ============================================================
// 7. FUNCTION: PREPARE DAILY CMIP6 IMAGE
// ============================================================

/*
  NASA/GDDP-CMIP6 units:

  pr      = kg m-2 s-1
  tas     = K
  tasmax  = K
  tasmin  = K
  hurs    = %
  huss    = kg/kg
  rlds    = W/m2
  rsds    = W/m2
  sfcWind = m/s

  Conversion:

  pr × 86400 = mm/day

  Temperature:
  K - 273.15 = °C
*/


function prepareDailyImage(image) {

  // ----------------------------------------------------------
  // Precipitation
  // ----------------------------------------------------------
  var pr = image
    .select('pr')
    .multiply(86400)
    .rename('pr');


  // ----------------------------------------------------------
  // Temperature
  // ----------------------------------------------------------
  var tas = image
    .select('tas')
    .subtract(273.15)
    .rename('tas');

  var tasmax = image
    .select('tasmax')
    .subtract(273.15)
    .rename('tasmax');

  var tasmin = image
    .select('tasmin')
    .subtract(273.15)
    .rename('tasmin');


  // ----------------------------------------------------------
  // Other variables
  // ----------------------------------------------------------
  var hurs = image
    .select('hurs')
    .rename('hurs');

  var rlds = image
    .select('rlds')
    .rename('rlds');

  var rsds = image
    .select('rsds')
    .rename('rsds');

  var sfcWind = image
    .select('sfcWind')
    .rename('sfcWind');


  // ----------------------------------------------------------
  // huss
  //
  // IMPORTANT:
  // huss is NOT available for MIROC6 in NASA/GDDP-CMIP6.
  //
  // We therefore create a fully masked huss band for MIROC6
  // so that the final output retains a consistent schema.
  // ----------------------------------------------------------

  var huss = ee.Image(
    ee.Algorithms.If(
      ee.String(image.get('model')).equals('MIROC6'),

      // Fully masked huss image
      ee.Image(0)
        .updateMask(ee.Image(0))
        .rename('huss'),

      // Normal huss band for other models
      image
        .select('huss')
        .rename('huss')
    )
  );


  // ----------------------------------------------------------
  // Combined all bands
  // ----------------------------------------------------------
  var output = ee.Image.cat([
    pr,
    tas,
    tasmax,
    tasmin,
    hurs,
    huss,
    rlds,
    rsds,
    sfcWind
  ]);


  // ----------------------------------------------------------
  // Preserve original image properties
  // ----------------------------------------------------------
  return output.copyProperties(
    image,
    image.propertyNames()
  );
}



// ============================================================
// 8. FUNCTION: CREATE MONTHLY CLIMATE IMAGE
// ============================================================

/*
  For every model × scenario × year × month:

  pr:
      SUM of daily precipitation (mm/day)

  Other variables:
      MEAN of daily values

  This produces one monthly climate image.
*/


function createMonthlyImage(
  model,
  scenario,
  year,
  month
) {

  model = ee.String(model);
  scenario = ee.String(scenario);
  year = ee.Number(year);
  month = ee.Number(month);


  // ----------------------------------------------------------
  // Start and end date
  // ----------------------------------------------------------

  var startDate = ee.Date.fromYMD(
    year,
    month,
    1
  );

  var endDate = startDate.advance(
    1,
    'month'
  );


  // ----------------------------------------------------------
  // Filter NASA GDDP-CMIP6
  // ----------------------------------------------------------

  var daily = CMIP6
    .filter(ee.Filter.eq('model', model))
    .filter(ee.Filter.eq('scenario', scenario))
    .filterDate(startDate, endDate);


  // ----------------------------------------------------------
  // Convert daily images
  // ----------------------------------------------------------

  var prepared = daily.map(
    prepareDailyImage
  );


  // ----------------------------------------------------------
  // MONTHLY PRECIPITATION
  //
  // SUM of daily mm/day
  // ----------------------------------------------------------

  var monthlyPr = prepared
    .select('pr')
    .sum()
    .rename('pr');


  // ----------------------------------------------------------
  // MONTHLY MEANS
  // ----------------------------------------------------------

  var monthlyMean = prepared
    .select([
      'tas',
      'tasmax',
      'tasmin',
      'hurs',
      'huss',
      'rlds',
      'rsds',
      'sfcWind'
    ])
    .mean();


  // ----------------------------------------------------------
  // Combine precipitation + other variables
  // ----------------------------------------------------------

  var monthlyImage = ee.Image.cat([
    monthlyPr,
    monthlyMean
  ]);


  // ----------------------------------------------------------
  // Add metadata
  // ----------------------------------------------------------

  monthlyImage = monthlyImage
    .set('MODEL', model)
    .set('SCENARIO', scenario)
    .set('YEAR', year)
    .set('MONTH', month)
    .set('system:time_start', startDate.millis());


  return monthlyImage;
}



// ============================================================
// 9. CREATE MONTHLY IMAGE COLLECTION
// ============================================================

/*
  Creates:

  5 models
  × 2 scenarios
  × 21 years
  × 12 months

  = 2,520 monthly climate images
*/


var years = ee.List.sequence(
  START_YEAR,
  END_YEAR
);


var monthlyImages = [];


// ------------------------------------------------------------
// Client-side loops are used only to construct the fixed
// 5 × 2 × 21 × 12 monthly image list.
// ------------------------------------------------------------

MODELS.forEach(function(model) {

  SCENARIOS.forEach(function(scenario) {

    for (
      var year = START_YEAR;
      year <= END_YEAR;
      year++
    ) {

      for (
        var month = 1;
        month <= 12;
        month++
      ) {

        monthlyImages.push(
          createMonthlyImage(
            model,
            scenario,
            year,
            month
          )
        );

      }

    }

  });

});


var monthlyCollection = ee.ImageCollection.fromImages(
  monthlyImages
);


